{
  "manifest_version": 3,
  "name": "Regex Toolkit",
  "version": "1.0.0",
  "description": "クリップボードのHTML/テキストに保存済み正規表現を順番に適用します。",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_title": "Regex Toolkit",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Regex Toolkit を開く"
    }
  }
}